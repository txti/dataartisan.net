# Keystatic GitHub mode (production /keystatic editor). Not needed for local dev.
# Create a GitHub App (Contents: read & write) with callback URL
#   https://dataartisan.net/api/keystatic/github/oauth/callback
# then set these in Netlify > Site configuration > Environment variables.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=            # any long random string
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
