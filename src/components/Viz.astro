---
// Frame for any chart or image in an MDX post: <Viz caption="…" source="…"> … </Viz>
interface Props { caption?: string; source?: string }
const { caption, source } = Astro.props
---
<figure>
  <div class="plate"><slot /></div>
  {(caption || source) && (
    <figcaption>
      {caption}{source && <span class="src">Source: {source}</span>}
    </figcaption>
  )}
</figure>
<style>
  figure { margin: 2.5rem 0; }
  .plate { background: rgba(255, 255, 255, 0.03); padding: 1.5rem; min-height: 12rem; display: grid; align-content: center; color: var(--muted); }
  .plate :global(p) { margin: 0; }
  figcaption { margin-top: 0.8rem; font-family: var(--mono); font-size: 0.72rem; color: var(--muted); }
  .src { display: block; opacity: 0.8; }
  /* With room to spare, let figures run past the text column on the right. */
  @media (min-width: 70rem) { figure { margin-right: -6rem; } }
</style>
