---
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'
const posts = (await getCollection('posts', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date)
const fmt = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short', day: 'numeric' })
---
<Base title="Writing">
  <div class="wrap">
    <h1>Writing</h1>
    <ul>
      {posts.map((p) => (
        <li>
          <time datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)} · {p.data.topic.replace('-', ' ')}</time>
          <a href={`/blog/${p.id}`}>{p.data.title}</a>
          <p>{p.data.description}</p>
        </li>
      ))}
    </ul>
  </div>
</Base>
<style>
  ul { list-style: none; padding: 0; margin: 2rem 0 0; }
  li { padding-block: 1.6rem; display: grid; gap: 0.3rem; }
  li a { font-size: 1.4rem; text-decoration: none; }
  li p { margin: 0; color: var(--muted); }
</style>
