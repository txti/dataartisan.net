---
import { getPosts } from '../lib/posts'
import Base from '../layouts/Base.astro'
import Robot from '../components/Robot.astro'
const posts = (await getPosts()).slice(0, 5)
const fmt = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short', day: 'numeric' })
---
<Base>
  <section class="wide hero">
    <p class="eyebrow">Data · Machines · Memory</p>
    <div class="stage">
      <h1>Data stories about artificial intelligence, a changing planet, and what we call progress, told through the people inside the numbers.</h1>
      <div class="art"><Robot /></div>
    </div>
  </section>
  <section class="wrap">
    <h2 class="eyebrow">Recent writing</h2>
    <ul>
      {posts.map((p) => (
        <li>
          <time datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time>
          <a href={`/blog/${p.id}`}>{p.data.title}</a>
          <p>{p.data.description}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>
<style>
  .hero { padding-block: 4rem 3rem; }
  /* The caption sits in the empty upper-left of the line art; both share one grid cell. */
  .stage { display: grid; margin-top: 1.2rem; }
  .stage > * { grid-area: 1 / 1; }
  .art { justify-self: end; width: 64%; }
  h1 { align-self: start; z-index: 1; max-width: 36rem; margin: 0; font-size: clamp(1.25rem, 2.2vw, 1.75rem); line-height: 1.3; }
  @media (max-width: 58rem) {
    .stage { display: block; }
    .art { width: 100%; margin-top: 2.5rem; }
    h1 { max-width: none; font-size: 1.5rem; }
  }
  ul { list-style: none; padding: 0; margin: 1.5rem 0 0; }
  li { padding-block: 1.6rem; display: grid; gap: 0.3rem; }
  li a { font-size: 1.4rem; text-decoration: none; }
  li p { margin: 0; color: var(--muted); }
</style>
