---
import { getPosts } from '../lib/posts'
import Base from '../layouts/Base.astro'
import Robot from '../components/Robot.astro'
const posts = (await getPosts()).slice(0, 5)
const fmt = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short', day: 'numeric' })
---
<Base>
  <section class="wide hero">
    <div class="art">
      <div class="cap">
        <p class="eyebrow">Data · Machines · Memory</p>
        <h1>Data stories about artificial intelligence, a changing planet, and what we call progress, told through the people inside the numbers.</h1>
      </div>
      <div class="pic"><Robot /></div>
    </div>
  </section>
  <section class="wrap">
    <h2 class="eyebrow">Recent writing</h2>
    <ul>
      {posts.map((p) => (
        <li>
          <time datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time>
          <a href={`/blog/${p.id}`}>{p.data.title}</a>
          <p>{p.data.description}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>
<style>
  .hero { padding-bottom: 3rem; }
  /* .art spans the page grid so the caption lines up with the header logo; the drawing is 54/64 of it, flush right. */
  .art { position: relative; container-type: inline-size; }
  .pic { width: 84.375%; margin-left: auto; }
  /* Top edge flush with the top of the second book (11.35% of the drawing's height down; the small offset trims the label's line-height). Stops short of the books. */
  .cap { position: absolute; top: calc(4.54cqi - 0.25rem); left: 0; width: 60%; z-index: 1; }
  .cap .eyebrow { margin: 0 0 1.4em; }
  h1 { margin: 0; font-size: max(1rem, 2.11cqi); line-height: 1.3; }
  @media (max-width: 46rem) {
    .pic { width: 100%; }
    .cap { position: static; width: auto; margin-bottom: 2.5rem; }
    h1 { font-size: 1.5rem; }
  }
  ul { list-style: none; padding: 0; margin: 1.5rem 0 0; }
  li { padding-block: 1.6rem; display: grid; gap: 0.3rem; }
  li a { font-size: 1.4rem; text-decoration: none; }
  li p { margin: 0; color: var(--muted); }
</style>
