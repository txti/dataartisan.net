---
import { getPosts } from '../lib/posts'
import Base from '../layouts/Base.astro'
import Robot from '../components/Robot.astro'
const posts = (await getPosts()).slice(0, 5)
const fmt = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short', day: 'numeric' })
---
<Base>
  <section class="wide hero">
    <div class="art">
      <div class="cap">
        <p class="eyebrow">Data · Machines · Memory</p>
        <h1>Data stories about artificial intelligence, a changing planet, and what we call progress, told through the people inside the numbers.</h1>
      </div>
      <Robot />
    </div>
  </section>
  <section class="wrap">
    <h2 class="eyebrow">Recent writing</h2>
    <ul>
      {posts.map((p) => (
        <li>
          <time datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time>
          <a href={`/blog/${p.id}`}>{p.data.title}</a>
          <p>{p.data.description}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>
<style>
  .hero { padding-block: 4rem 3rem; }
  /* The caption is set inside the art's own box, in the empty space above the android's head. */
  .art { position: relative; container-type: inline-size; width: min(100%, 54rem); margin-left: auto; }
  /* Anchored by its bottom edge: sits just above the android's head (about 20.5% of the art's width from the top) and stops short of the books (about 59%). */
  .cap { position: absolute; bottom: 28.9cqi; left: 0; width: 56%; z-index: 1; }
  .cap .eyebrow { margin: 0 0 0.6em; }
  h1 { margin: 0; font-size: max(1rem, 2.5cqi); line-height: 1.3; }
  @media (max-width: 46rem) {
    .cap { position: static; width: auto; margin-bottom: 2.5rem; }
    h1 { font-size: 1.5rem; }
  }
  ul { list-style: none; padding: 0; margin: 1.5rem 0 0; }
  li { padding-block: 1.6rem; display: grid; gap: 0.3rem; }
  li a { font-size: 1.4rem; text-decoration: none; }
  li p { margin: 0; color: var(--muted); }
</style>
