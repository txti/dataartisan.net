---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import Horizon from '../components/Horizon.astro'
const posts = (await getCollection('posts', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 5)
const fmt = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short', day: 'numeric' })
---
<Base>
  <section class="wide hero">
    <p class="eyebrow">Data · Machines · Memory</p>
    <h1>Do we dream of what we measure?</h1>
    <p class="lede">Visual essays on the dawn of artificial intelligence, a changing planet, the idea of progress, and the places where evidence and emotion both fail us.</p>
    <Horizon />
  </section>
  <section class="wrap">
    <h2 class="eyebrow">Recent writing</h2>
    <ul>
      {posts.map((p) => (
        <li>
          <time datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time>
          <a href={`/blog/${p.id}`}>{p.data.title}</a>
          <p>{p.data.description}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>
<style>
  .hero { padding-block: 4rem 3rem; }
  .hero h1 { max-width: 14ch; margin: 0.4em 0; font-size: clamp(2.4rem, 7vw, 4.5rem); }
  .lede { max-width: 34rem; color: var(--muted); font-size: 1.15rem; margin-bottom: 4rem; }
  ul { list-style: none; padding: 0; margin: 1.5rem 0 0; }
  li { padding-block: 1.4rem; border-top: 1px solid var(--line); display: grid; gap: 0.2rem; }
  li a { font-size: 1.4rem; text-decoration: none; }
  li p { margin: 0; color: var(--muted); }
</style>
